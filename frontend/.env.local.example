# VideoLens 前端环境变量示例
# 复制为 .env.local 并按需修改

# === 认证 ===
# JWT 签名密钥. 本地开发不设也行 (会用默认开发密钥), 生产必须改成随机字符串!
# 生成: openssl rand -hex 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# === Postgres (用户/播放进度/thread 元数据/LangGraph checkpointer) ===
# 与 db/docker-compose.yml 默认值一致, 仅本地开发用. 生产务必改密码!
# 启动 Postgres: docker compose -f db/docker-compose.yml up -d
POSTGRES_URL=postgresql://videolens:videolens_dev@127.0.0.1:25432/videolens

# === LangGraph 服务 ===
# langgraph dev 启动地址 (默认 http://127.0.0.1:2024)
LANGGRAPH_API_URL=http://127.0.0.1:2024

# 本地 langgraph dev 不需要, 部署到 LangGraph Cloud 时填 LangSmith API Key
LANGSMITH_API_KEY=

# 多租户场景才需要 (例如 Agent Builder 部署)
LANGGRAPH_AUTH_SCHEME=

# === 前端 (浏览器侧可见, 会打包进 bundle) ===
# 这些 NEXT_PUBLIC_ 前缀变量会暴露给浏览器, 仅用于「告诉前端 SDK 去哪连」
NEXT_PUBLIC_API_URL=http://127.0.0.1:2024
NEXT_PUBLIC_VIDEO_SERVER_URL=http://127.0.0.1:9802
NEXT_PUBLIC_ASSISTANT_ID=agent
# NEXT_PUBLIC_AUTH_SCHEME=

# === 后续接入付费功能时再填 ===
# 阿里云短信 (开通后填)
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# 微信扫码登录 (开放平台网站应用, 开通后填)
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=

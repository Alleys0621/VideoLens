      "text": "谢谢各位了。"
    },
    {
      "start_time": 905.6,
      "end_time": 906.72,
      "text": "走吧走吧走吧。"
    },
    {
      "start_time": 906.8,
      "end_time": 908.96,
      "text": "走吧，你去走吧小孩。"
    },
    {
      "start_time": 909.04,
      "end_time": 909.84,
      "text": "没有嘛。"

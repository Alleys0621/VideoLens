  "segments": [
    {
      "start_time": 75.238,
      "end_time": 77.398,
      "text": "下界是何声响？"
    },
    {
      "start_time": 80.948,
      "end_time": 82.688,
      "text": "臣等不知。"
    },
    {
      "start_time": 84.888,
      "end_time": 86.478,
      "text": "千里眼、顺风耳。"
    },
    {
      "start_time": 88.148,
      "end_time": 88.918,
      "text": "臣在。"
    },
    {
      "start_time": 89.078,
      "end_time": 90.828,
      "text": "速去查看明白。"
    },
    {
      "start_time": 107.459,
      "end_time": 109.599,
      "text": "陛下，臣等奉旨观听，"
    },
    {
      "start_time": 109.599,
      "end_time": 113.689,
      "text": "原来下界山峰崩裂，化出一个石猴。"
    },
    {
      "start_time": 115.459,
      "end_time": 117.489,
      "text": "为此响震天宇。"
    },
    {
      "start_time": 117.979,
      "end_time": 119.989,
      "text": "哦，是个石猴啊。"
    },
    {
      "start_time": 120.0,
      "end_time": 121.16,
      "text": "不必管他。"
    },
    {
      "start_time": 221.708,
      "end_time": 222.368,
      "text": "他来了"
    },
    {
      "start_time": 222.598,
      "end_time": 223.158,
      "text": "他来了"
    },
    {
      "start_time": 226.998,
      "end_time": 227.458,
      "text": "你瞧"
    },
    {
      "start_time": 227.958,
      "end_time": 228.338,
      "text": "这个"
    },
    {
      "start_time": 229.628,
      "end_time": 230.268,
      "text": "走走走"
    },
    {
      "start_time": 241.436,
      "end_time": 241.726,
      "text": "快走！"
    },
    {
      "start_time": 243.586,
      "end_time": 243.956,
      "text": "快走快！"
    },
    {
      "start_time": 280.942,
      "end_time": 281.742,
      "text": "谁敢进去？"
    },
    {
      "start_time": 285.492,
      "end_time": 286.062,
      "text": "我敢进去！"
    },
    {
      "start_time": 286.442,
      "end_time": 287.452,
      "text": "你敢去？你敢去？"
    },
    {
      "start_time": 290.152,
      "end_time": 293.512,
      "text": "你要能进得去，出得来，我们就拜你为王。"
    },
    {
      "start_time": 297.442,
      "end_time": 297.792,
      "text": "当真？"
    },
    {
      "start_time": 298.422,
      "end_time": 299.622,
      "text": "我要是进得去，出得来，"
    },
    {
      "start_time": 300.243,
      "end_time": 301.373,
      "text": "你们就拜我为王。"
    },
    {
      "start_time": 369.822,
      "end_time": 371.572,
      "text": "石猴怕是出不来了。"
    },
    {
      "start_time": 374.362,
      "end_time": 374.702,
      "text": "你看！"
    },
    {
      "start_time": 374.702,
      "end_time": 376.892,
      "text": "出来了，出来了！"
    },
    {
      "start_time": 376.892,
      "end_time": 378.522,
      "text": "出来了，出来了！"
    },
    {
      "start_time": 379.542,
      "end_time": 381.142,
      "text": "造化，造化！"
    },
    {
      "start_time": 381.652,
      "end_time": 382.952,
      "text": "里头有什么好东西？"
    },
    {
      "start_time": 383.232,
      "end_time": 384.082,
      "text": "里面可好了。"
    },
    {
      "start_time": 384.332,
      "end_time": 386.312,
      "text": "里面是天造地设的一副家当。"
    },
    {
      "start_time": 386.672,
      "end_time": 388.272,
      "text": "嗯，快随我到里面去住。"
    },
    {
      "start_time": 388.572,
      "end_time": 389.982,
      "text": "走走走。"
    },
    {
      "start_time": 390.342,
      "end_time": 392.742,
      "text": "就怕我们大家进不去呀，啊？"
    },
    {
      "start_time": 393.582,
      "end_time": 394.652,
      "text": "进得去，进得去。"
    },
    {
      "start_time": 395.152,
      "end_time": 396.972,
      "text": "过了这水帘就没事了。"
    },
    {
      "start_time": 397.292,
      "end_time": 399.692,
      "text": "那好，你先走，我们跟着你。"
    },
    {
      "start_time": 399.692,
      "end_time": 401.252,
      "text": "来来来，跟着走，跟着走。"
    },
    {
      "start_time": 433.017,
      "end_time": 433.597,
      "text": "好洞"
    },
    {
      "start_time": 440.677,
      "end_time": 443.777,
      "text": "真是神仙洞府啊！"
    },
    {
      "start_time": 445.457,
      "end_time": 447.137,
      "text": "这下全归我们了。"
    },
    {
      "start_time": 455.497,
      "end_time": 456.897,
      "text": "刚才我们不是说过，"
    },
    {
      "start_time": 456.897,
      "end_time": 459.697,
      "text": "谁要是有本事进得来出得去，"
    },
    {
      "start_time": 459.697,
      "end_time": 461.217,
      "text": "我们就拜他为王啊。"
    },
    {
      "start_time": 462.737,
      "end_time": 464.497,
      "text": "言而无信呐。"
    },
    {
      "start_time": 464.497,
      "end_time": 465.777,
      "text": "对对对，拜他为王。"
    },
    {
      "start_time": 469.057,
      "end_time": 470.577,
      "text": "看看看，在那儿呢。"
    },
    {
      "start_time": 597.389,
      "end_time": 599.629,
      "text": "大王,你看小的们多老实。"
    },
    {
      "start_time": 600.128,
      "end_time": 605.768,
      "text": "大王，我们在这仙山福地，上不受天管，下不受地管。"
    },
    {
      "start_time": 605.768,
      "end_time": 607.418,
      "text": "真是自由自在呀。"
    },
    {
      "start_time": 641.348,
      "end_time": 643.608,
      "text": "大王，他死了。"
    },
    {
      "start_time": 648.208,
      "end_time": 650.928,
      "text": "这……大王，他死了。"
    },
    {
      "start_time": 651.448,
      "end_time": 651.928,
      "text": "死了？"
    },
    {
      "start_time": 652.448,
      "end_time": 655.208,
      "text": "他乃年老体衰，气绝身亡。"
    },
    {
      "start_time": 655.448,
      "end_time": 659.848,
      "text": "我等无有长生之术，日后也不免于死。"
    },
    {
      "start_time": 660.0,
      "end_time": 661.2,
      "text": "死啦！"
    },
    {
      "start_time": 663.04,
      "end_time": 665.12,
      "text": "日后我等也不免于死吗？"
    },
    {
      "start_time": 665.12,
      "end_time": 666.32,
      "text": "嗯，是啊。"
    },
    {
      "start_time": 674.08,
      "end_time": 677.36,
      "text": "大王，我也无有长生之术啊。"
    },
    {
      "start_time": 680.56,
      "end_time": 680.96,
      "text": "大王。"
    },
    {
      "start_time": 682.0,
      "end_time": 688.4,
      "text": "何不去到古洞仙山，寻访名师，学一个长生之道啊？"
    },
    {
      "start_time": 688.8,
      "end_time": 689.6,
      "text": "长生之道？"
    },
    {
      "start_time": 758.579,
      "end_time": 759.149,
      "text": "妖怪"
    },
    {
      "start_time": 760.239,
      "end_time": 760.749,
      "text": "快走吧"
    },
    {
      "start_time": 761.029,
      "end_time": 761.659,
      "text": "哎呀，快走"
    },
    {
      "start_time": 762.229,
      "end_time": 762.419,
      "text": "哎"
    },
    {
      "start_time": 762.729,
      "end_time": 762.979,
      "text": "嗯？"
    },
    {
      "start_time": 763.629,
      "end_time": 764.069,
      "text": "哎！"
    },
    {
      "start_time": 767.379,
      "end_time": 767.609,
      "text": "哎"
    },
    {
      "start_time": 768.249,
      "end_time": 770.839,
      "text": "您吃我这个祖传秘方大力丸"
    },
    {
      "start_time": 771.279,
      "end_time": 774.379,
      "text": "您敢，强筋壮骨，力大无穷"
    },
    {
      "start_time": 776.929,
      "end_time": 778.799,
      "text": "哎，有钱的您捧个钱场"
    },
    {
      "start_time": 779.099,
      "end_time": 779.779,
      "text": "没钱的"
    },
    {
      "start_time": 780.483,
      "end_time": 781.363,
      "text": "人哪,嘿"
    },
    {
      "start_time": 781.763,
      "end_time": 782.723,
      "text": "您看我这个啊"
    },
    {
      "start_time": 783.043,
      "end_time": 784.483,
      "text": "我给您练个叉看看"
    },
    {
      "start_time": 784.963,
      "end_time": 785.283,
      "text": "哎"
    },
    {
      "start_time": 787.283,
      "end_time": 787.763,
      "text": "看这个啊"
    },
    {
      "start_time": 795.603,
      "end_time": 796.323,
      "text": "妖怪!"
    },
    {
      "start_time": 796.483,
      "end_time": 797.283,
      "text": "妖怪快跑!"
    },
    {
      "start_time": 797.283,

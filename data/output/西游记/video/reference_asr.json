    {
      "start_time": 977.28,
      "end_time": 978.0,
      "text": "哎呦，这什么？"
    },
    {
      "start_time": 978.08,
      "end_time": 978.8,
      "text": "快走快走快走。"
    },
    {
      "start_time": 978.88,
      "end_time": 980.0,
      "text": "妖怪妖怪妖怪。"
    },
    {
      "start_time": 980.08,
      "end_time": 981.2,
      "text": "快跑快跑。"
    },
    {
      "start_time": 986.8,
      "end_time": 988.8,
      "text": "好菜来啦！"
    },
    {
      "start_time": 990.0,
      "end_time": 993.2,
      "text": "哎呦，哎客官，您来点什么啊？"
    },
    {
      "start_time": 993.6,
      "end_time": 995.2,
      "text": "呃，堂倌。"
    },
    {
      "start_time": 995.28,
      "end_time": 998.0,
      "text": "哦，您来了，请坐。"

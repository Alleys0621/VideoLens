    },
    {
      "start_time": 1017.68,
      "end_time": 1018.8,
      "text": "哦，好好好。"
    },
    {
      "start_time": 1020.482,
      "end_time": 1021.372,
      "text": "一大碗面。"
    },
    {
      "start_time": 1021.372,
      "end_time": 1022.042,
      "text": "一大碗面。"
    },
    {
      "start_time": 1022.042,
      "end_time": 1022.942,
      "text": "一大碗面。"
    },
    {
      "start_time": 1022.942,
      "end_time": 1024.282,
      "text": "你也要一大碗面。"
    },
    {
      "start_time": 1080.168,
      "end_time": 1085.728,
      "text": "哎呀,你看这人,连面条也不会吃。"
    },
    {
      "start_time": 1090.048,
      "end_time": 1091.128,
      "text": "你呀你呀。"
    },
    {
      "start_time": 1114.953,
      "end_time": 1117.033,
      "text": "就是放辣椒,辣椒,辣椒了。"
    },
    {
      "start_time": 1195.371,
      "end_time": 1196.091,
      "text": "老神仙"
    },
    {
      "start_time": 1200.48,
      "end_time": 1201.76,
      "text": "我以打柴为生"
    },
    {
      "start_time": 1202.32,
      "end_time": 1204.08,
      "text": "衣食还不得周全"
    },
    {
      "start_time": 1204.48,
      "end_time": 1206.08,
      "text": "怎么敢当神仙二字啊"

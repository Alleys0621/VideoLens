      "text": "好嘞，这就来您呐。"
    },
    {
      "start_time": 958.24,
      "end_time": 960.0,
      "text": "哎，各位，我是…"
    },
    {
      "start_time": 960.0,
      "end_time": 961.28,
      "text": "姐夫，来来来。"
    },
    {
      "start_time": 961.36,
      "end_time": 962.48,
      "text": "来来来，吃菜吃菜。"
    },
    {
      "start_time": 962.56,
      "end_time": 963.2,
      "text": "好。"
    },
    {
      "start_time": 964.24,
      "end_time": 964.72,
      "text": "来来来。"
    },
    {
      "start_time": 965.36,
      "end_time": 966.08,
      "text": "坐坐坐。"
    },
    {
      "start_time": 966.16,
      "end_time": 966.88,
      "text": "来来来。"
    },
    {
      "start_time": 969.68,
      "end_time": 970.32,
      "text": "喝喝喝。"

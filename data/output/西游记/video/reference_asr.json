    {
      "start_time": 888.418,
      "end_time": 890.258,
      "text": "不是，不是。"
    },
    {
      "start_time": 890.538,
      "end_time": 895.548,
      "text": "刚才一个毛脸的、毛胳膊毛腿的妖精进去了。"
    },
    {
      "start_time": 896.498,

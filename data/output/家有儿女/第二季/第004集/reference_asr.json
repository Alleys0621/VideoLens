    },
    {
      "start_time": 1253.92,
      "end_time": 1256.8,
      "text": "啊？怎么了？这不就是他吗？"
    },
    {
      "start_time": 1256.8,
      "end_time": 1257.28,
      "text": "是啊。"
    },
    {
      "start_time": 1257.28,
      "end_time": 1259.92,
      "text": "哎呦，我自己生的孩子我能不知道吗？"
    },
    {
      "start_time": 1260.24,
      "end_time": 1261.28,
      "text": "这不是我们家宝宝。"
    },
    {
      "start_time": 1261.36,
      "end_time": 1262.24,
      "text": "绝对不是。"
    },
    {
      "start_time": 1262.56,

    },
    {
      "start_time": 40.723,
      "end_time": 42.403,
      "text": "是爱情誓言吧。"
    },
    {
      "start_time": 42.403,
      "end_time": 43.363,
      "text": "不不不不不是不是。"
    },
    {
      "start_time": 43.763,
      "end_time": 44.883,
      "text": "呃，我还是到外面待会儿吧。"
    },
    {
      "start_time": 49.203,
      "end_time": 50.803,
      "text": "别怕，我们会保护你的。"
    },
    {
      "start_time": 51.923,

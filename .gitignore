# Environments
.env

# IDE
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# === 视频 / 媒体 (太大, 不上传) ===
data/videos/
data/models/
models/*.onnx

# === 流水线大文件 (可重新跑 pipeline 生成) ===
# 注意: data/output/ 下的 JSON 知识库文件 *要* 上传 (别人部署后 Alleys 才能聊天)
# 只 ignore 大文件:
data/output/**/*.wav
data/output/**/*.npz
data/output/**/keyframes/
data/output/**/_stage3_dryrun.log
data/output/_batch_reports/

# === LangGraph checkpoint (对话状态快照, 不通用, 但 store.pckl 要上传) ===
.langgraph_api/.langgraph_checkpoint.*
.langgraph_api/.langgraph_ops.pckl
.langgraph_api/.langgraph_retry_counter.pckl
.langgraph_api/store.vectors.pckl

# Experiments data
experiments/_archive/
experiments/results/
experiments/test_omni_result/

# Logs
*.log

# Media files (images, audio, video)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.svg
# 例外: 前端 logo/avatar 等静态资源必须上传
!frontend/public/**
!data/output/_global/**
!data/gt/**
